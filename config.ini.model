[OPENSEARCH]
HOST = elk.lareferencia.info
PORT = 443
SSL = True
BASIC_AUTH_ENABLED = false
USER = lareferencia
PASSWORD = lareferencia

[USAGE_STATS_DB]
HOST = usage-db
PORT = 3306
USERNAME = stats
PASSWORD = stats
DATABASE = lareferencia_usage_stats
HELPER_REFRESH_SECONDS = 300

[USAGE_STATS_INDEX]
INDEX_PREFIX = usage-stats

[CORS]
# Optional. If ENABLED is missing or false, service starts without CORS middleware.
# ENABLED = true
# ALLOWED_ORIGINS = http://localhost:3000,http://localhost:8080
# Optional origin registry for later CORS allowlist curation.
# TRACK_ORIGINS = true
# TRACK_ORIGINS_FILE = origins.txt
FILENAME = cors.txt







